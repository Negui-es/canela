# Docker Compose reads this file when copied to .env.
POSTGRES_PASSWORD=
SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
ALLOW_NEW_ACCOUNTS=0
TRUST_PROXY=0
# Before using the public domain:
# DEBUG=0
# ALLOWED_HOSTS=ceramica.example.org,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://ceramica.example.org
# TRUST_PROXY=1
