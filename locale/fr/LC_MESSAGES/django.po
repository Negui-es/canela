msgid "Agotado"
msgstr "Épuisé"

msgid "No disponible"
msgstr "Indisponible"

msgid "Cambiar disponibilidad"
msgstr "Modifier la disponibilité"

msgid "Disponibilidad actualizada."
msgstr "Disponibilité mise à jour."

msgid ""
"No disponible para piezas nuevas. Se conserva en las piezas anteriores."
msgstr ""
"Indisponible pour les nouvelles pièces. Conservé dans les pièces "
"antérieures."

msgid "Ver no disponibles"
msgstr "Voir les indisponibles"

msgid "No hay materiales no disponibles."
msgstr "Aucun matériau indisponible."

msgid ""
"No disponibles: solo tus materiales y los de los talleres que administras."
msgstr ""
"Indisponibles : uniquement vos matériaux et ceux des ateliers que vous "
"administrez."

