msgstr "Masquer"

msgid "Mostrar contraseña"
msgstr "Afficher le mot de passe"

msgid "Ocultar contraseña"
msgstr "Masquer le mot de passe"

msgid "Cambios sin guardar"
msgstr "Modifications non enregistrées"

