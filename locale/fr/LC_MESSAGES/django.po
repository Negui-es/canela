msgstr "Les nouvelles photos s’ajoutent aux photos enregistrées."

msgid ""
"Añade los ingredientes de tu receta. Los porcentajes deben sumar 100 %."
msgstr ""
"Ajoutez les ingrédients de votre recette. Les pourcentages doivent totaliser"
" 100 %."

msgid "Añadir ingrediente"
msgstr "Ajouter un ingrédient"

msgid "Quitar ingrediente"
msgstr "Retirer l’ingrédient"

msgid "Se retirará a %(name)s de este grupo. Sus piezas se conservan."
msgstr "%(name)s sera retiré de ce groupe. Ses pièces seront conservées."

msgid "Confirmar retirada"
msgstr "Confirmer le retrait"

msgid ""
"Este nombre acompaña a tus piezas compartidas. Si lo dejas vacío, se muestra"
" tu usuario."
msgstr ""
"Ce nom accompagne vos pièces partagées. Laissez-le vide pour afficher votre "
"identifiant."

msgid "Mostrar"
msgstr "Afficher"

