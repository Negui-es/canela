msgstr "stampi/<uuid:pk>/ritira/"

msgid "Agotado"
msgstr "Esaurito"

msgid "No disponible"
msgstr "Non disponibile"

msgid "Cambiar disponibilidad"
msgstr "Cambia disponibilità"

msgid "Disponibilidad actualizada."
msgstr "Disponibilità aggiornata."

msgid ""
"No disponible para piezas nuevas. Se conserva en las piezas anteriores."
msgstr "Non disponibile per nuovi pezzi. Conservato nei pezzi precedenti."

msgid "Ver no disponibles"
msgstr "Vedi non disponibili"

msgid "No hay materiales no disponibles."
msgstr "Non ci sono materiali non disponibili."

msgid ""
"No disponibles: solo tus materiales y los de los talleres que administras."
msgstr ""
"Non disponibili: solo i tuoi materiali e quelli dei laboratori che "
"amministri."

