msgstr "Review these fields before saving"

msgid "Las fotos nuevas se añaden a las guardadas."
msgstr "New photos are added to your saved photos."

msgid ""
"Añade los ingredientes de tu receta. Los porcentajes deben sumar 100 %."
msgstr "Add your recipe ingredients. Percentages must total 100%."

msgid "Añadir ingrediente"
msgstr "Add ingredient"

msgid "Quitar ingrediente"
msgstr "Remove ingredient"

msgid "Se retirará a %(name)s de este grupo. Sus piezas se conservan."
msgstr ""
"%(name)s will be removed from this group. Their pieces will be preserved."

msgid "Confirmar retirada"
msgstr "Confirm removal"

msgid ""
"Este nombre acompaña a tus piezas compartidas. Si lo dejas vacío, se muestra"
" tu usuario."
msgstr ""
"This name appears with your shared pieces. Leave it empty to show your "
"username."

msgid "Mostrar"
msgstr "Show"

msgid "Ocultar"
msgstr "Hide"

msgid "Mostrar contraseña"
msgstr "Show password"

msgid "Ocultar contraseña"
msgstr "Hide password"

msgid "Cambios sin guardar"
msgstr "Unsaved changes"

msgid "Total"
msgstr "Total"

msgid "Los porcentajes deben sumar 100 %."
msgstr "Percentages must total 100%."

msgid "No se pudo actualizar la búsqueda. Vuelve a intentarlo."
msgstr "The search could not be updated. Please try again."

msgid "Indica una cantidad entre 0 y 1.000.000 g."
msgstr "Enter an amount between 0 and 1,000,000 g."

msgid "En Inspiración"
msgstr "In Inspiration"

msgid ""
"Aún no tienes talleres. Puedes crearlos en «Talleres» y compartir más "
"adelante."
msgstr "You have no workshops yet. Create one in “Workshops” and share later."

msgid "Invitar a otra persona"
msgstr "Invite someone"

msgid "Nuevo taller"
msgstr "New workshop"

msgid "＋ Nuevo taller"
msgstr "＋ New workshop"

msgid "Taller independiente"
msgstr "Independent workshop"

msgid "Organiza tus talleres y sus subgrupos."
msgstr "Organize your workshops and their subgroups."

msgid ""
"Crea tu cuenta para empezar. Después podrás invitar a otras personas desde "
"«Mi cuenta»."
msgstr ""
"Create your account to get started. You can then invite others from “My "
"account”."
