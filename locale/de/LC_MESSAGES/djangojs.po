msgstr "Dieses Foto kann nicht geladen werden."

msgid "Pruebas de aplicación"
msgstr "Auftragsproben"

msgid "Puedes subir hasta 4 fotos cada vez."
msgstr "Du kannst bis zu 4 Fotos auf einmal hochladen."

#, python-format
msgid "Quitar %(name)s"
msgstr "%(name)s entfernen"

