msgstr "Verwende JPG-, PNG- oder WebP-Bilder."

msgid "Visor de fotografías"
msgstr "Fotoanzeige"

msgid ""
"Las pruebas con barro, capas y temperatura se añaden desde la ficha del "
"material."
msgstr ""
"Füge Proben mit Ton, Schichten und Temperatur auf der Materialseite hinzu."

msgid ""
"Los ingredientes, las mezclas y las pruebas se gestionan desde la ficha del "
"material."
msgstr "Verwalte Zutaten, Mischungen und Proben auf der Materialseite."

msgid "Sin materiales asignados. Puedes añadirlos más adelante."
msgstr "Keine Materialien zugewiesen. Du kannst sie später hinzufügen."

msgid "%(count)s material seleccionado"
msgid_plural "%(count)s materiales seleccionados"
msgstr[0] "%(count)s Material ausgewählt"
