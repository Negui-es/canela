msgid "Agotado"
msgstr "Aufgebraucht"

msgid "No disponible"
msgstr "Nicht verfügbar"

msgid "Cambiar disponibilidad"
msgstr "Verfügbarkeit ändern"

msgid "Disponibilidad actualizada."
msgstr "Verfügbarkeit aktualisiert."

msgid ""
"No disponible para piezas nuevas. Se conserva en las piezas anteriores."
msgstr ""
"Für neue Stücke nicht verfügbar. Bleibt in bisherigen Stücken erhalten."

msgid "Ver no disponibles"
msgstr "Nicht verfügbare anzeigen"

msgid "No hay materiales no disponibles."
msgstr "Keine nicht verfügbaren Materialien."

msgid ""
"No disponibles: solo tus materiales y los de los talleres que administras."
msgstr ""
"Nicht verfügbar: nur deine Materialien und die der Werkstätten, die du "
"verwaltest."

