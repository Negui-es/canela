msgid "piezas/<uuid:pk>/publicacion/"
msgstr "stuecke/<uuid:pk>/veroeffentlichung/"

msgid "En %(count)s galería"
msgid_plural "En %(count)s galerías"
msgstr[0] "In %(count)s Galerie"
msgstr[1] "In %(count)s Galerien"

msgid "Cerrar"
msgstr "Schließen"

msgid "Foto anterior"
msgstr "Vorheriges Foto"

msgid "Foto siguiente"
msgstr "Nächstes Foto"

msgid "Revisa estos campos antes de guardar"
msgstr "Prüfe diese Felder vor dem Speichern"

msgid "Las fotos nuevas se añaden a las guardadas."
msgstr "Neue Fotos werden zu den gespeicherten Fotos hinzugefügt."

msgid ""
"Añade los ingredientes de tu receta. Los porcentajes deben sumar 100 %."
msgstr ""
"Füge die Zutaten deiner Rezeptur hinzu. Die Anteile müssen zusammen 100 % "
"ergeben."

msgid "Añadir ingrediente"
msgstr "Zutat hinzufügen"

msgid "Quitar ingrediente"
msgstr "Zutat entfernen"

msgid "Se retirará a %(name)s de este grupo. Sus piezas se conservan."
msgstr ""
"%(name)s wird aus dieser Gruppe entfernt. Die eigenen Stücke bleiben "
"erhalten."

msgid "Confirmar retirada"
msgstr "Entfernen bestätigen"

msgid ""
"Este nombre acompaña a tus piezas compartidas. Si lo dejas vacío, se muestra"
" tu usuario."
msgstr ""
"Dieser Name erscheint bei deinen geteilten Stücken. Ohne Angabe wird dein "
"Benutzername angezeigt."

msgid "Mostrar"
msgstr "Anzeigen"

msgid "Ocultar"
msgstr "Ausblenden"

msgid "Mostrar contraseña"
msgstr "Passwort anzeigen"

msgid "Ocultar contraseña"
msgstr "Passwort ausblenden"

msgid "Cambios sin guardar"
msgstr "Ungespeicherte Änderungen"

msgid "Total"
msgstr "Gesamt"

msgid "Los porcentajes deben sumar 100 %."
msgstr "Die Anteile müssen zusammen 100 % ergeben."

msgid "No se pudo actualizar la búsqueda. Vuelve a intentarlo."
msgstr "Die Suche konnte nicht aktualisiert werden. Versuche es erneut."

msgid "Indica una cantidad entre 0 y 1.000.000 g."
msgstr "Gib eine Menge zwischen 0 und 1.000.000 g ein."

msgid "En Inspiración"
msgstr "In Inspiration"

msgid ""
"Aún no tienes talleres. Puedes crearlos en «Talleres» y compartir más "
"adelante."
msgstr ""
"Du hast noch keine Werkstätten. Erstelle eine unter „Werkstätten“ und teile "
"später."

msgid "Invitar a otra persona"
msgstr "Eine weitere Person einladen"

msgid "Nuevo taller"
msgstr "Neue Werkstatt"

msgid "＋ Nuevo taller"
msgstr "＋ Neue Werkstatt"

msgid "Taller independiente"
msgstr "Eigenständige Werkstatt"

msgid "Organiza tus talleres y sus subgrupos."
msgstr "Organisiere deine Werkstätten und ihre Untergruppen."

msgid ""
"Crea tu cuenta para empezar. Después podrás invitar a otras personas desde "
"«Mi cuenta»."
msgstr ""
"Erstelle dein Konto, um loszulegen. Anschließend kannst du unter „Mein "
"Konto“ weitere Personen einladen."
