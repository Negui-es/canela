msgid "esmaltes/<uuid:pk>/disponibilidad/"
msgstr "glasuren/<uuid:pk>/verfuegbarkeit/"

msgctxt "URL"
msgid "moldes/<uuid:pk>/disponibilidad/"
msgstr "formen/<uuid:pk>/verfuegbarkeit/"

msgid "Estado del molde"
msgstr "Zustand der Form"

msgid "Buen estado"
msgstr "Guter Zustand"

msgid "Tus galerías personales y las de tus talleres, en un mismo lugar."
msgstr "Deine persönlichen Galerien und Werkstattgalerien an einem Ort."

msgid "Personales"
msgstr "Persönlich"

msgid "De tus talleres"
msgstr "Aus deinen Werkstätten"

msgid "Compartidas contigo"
msgstr "Mit dir geteilt"

msgid "Tus talleres, sus miembros y su organización."
msgstr "Deine Werkstätten, ihre Mitglieder und ihre Organisation."

msgid "Miembros del taller"
msgstr "Mitglieder der Werkstatt"

msgid "Abrir galería"
msgstr "Galerie öffnen"

msgid "Inspiración"
msgstr "Inspiration"

msgid "Publicar en Inspiración"
msgstr "In Inspiration veröffentlichen"

msgid "Retirar de Inspiración"
msgstr "Aus Inspiration entfernen"

msgid "Publicada en Inspiración"
msgstr "In Inspiration veröffentlicht"

msgid "Sin publicar en Inspiración"
msgstr "Nicht in Inspiration veröffentlicht"

msgid "Guardar y añadir a la galería"
msgstr "Speichern und zur Galerie hinzufügen"

msgid "Lo que quieres contar"
msgstr "Was du erzählen möchtest"

msgid "Dónde aparece"
msgstr "Wo sie erscheint"

msgid "Vista previa"
msgstr "Vorschau"

msgid "Volver"
msgstr "Zurück"

msgid "Entrar"
msgstr "Anmelden"

msgid "Fotografías y portada"
msgstr "Fotos und Titelbild"

msgid "Portada de la presentación"
msgstr "Titelbild der Präsentation"

msgid "Primera foto seleccionada"
msgstr "Erstes ausgewähltes Foto"

msgid "Selecciona también la foto elegida como portada."
msgstr "Wähle auch das als Titelbild gewählte Foto aus."

msgid "Selecciona una foto para ver la portada."
msgstr "Wähle ein Foto für die Titelbildvorschau."

msgid "Selecciona al menos una foto para publicar en Inspiración."
msgstr "Wähle mindestens ein Foto, um in Inspiration zu veröffentlichen."

msgid "Una pieza publicada en Inspiración necesita al menos una foto."
msgstr ""
"Ein in Inspiration veröffentlichtes Stück benötigt mindestens ein Foto."

msgid "Retira la publicación antes de quitar todas las fotos."
msgstr "Entferne die Veröffentlichung, bevor du alle Fotos entfernst."

msgid ""
"Revisa la presentación y selecciona al menos una foto antes de publicar."
msgstr ""
"Prüfe die Präsentation und wähle vor der Veröffentlichung mindestens ein "
"Foto."

msgid "Pieza publicada en Inspiración."
msgstr "Stück in Inspiration veröffentlicht."

msgid "Pieza retirada de Inspiración. Sus galerías se conservan."
msgstr "Stück aus Inspiration entfernt. Seine Galerien bleiben erhalten."

msgid "Presentación guardada."
msgstr "Präsentation gespeichert."

msgid "Revisa tu presentación"
msgstr "Prüfe deine Präsentation"

msgid "UNA PRESENTACIÓN, TODOS LOS ESPACIOS"
msgstr "EINE PRÄSENTATION, ALLE BEREICHE"

msgid "Elige cómo mostrar tu pieza en las galerías y en Inspiración."
msgstr "Wähle, wie dein Stück in Galerien und Inspiration erscheint."

msgid ""
"Tus notas, historial y recetas privadas quedan fuera de esta presentación."
msgstr ""
"Deine privaten Notizen, der Verlauf und Rezepte bleiben außerhalb dieser "
"Präsentation."

msgid ""
"Solo estos textos y las fotos seleccionadas se mostrarán en las galerías y "
"en Inspiración."
msgstr ""
"Nur diese Texte und ausgewählten Fotos erscheinen in Galerien und "
"Inspiration."

msgid "Solo se mostrarán las fotos seleccionadas."
msgstr "Nur ausgewählte Fotos werden angezeigt."

msgid "Añade fotos a tu pieza para poder publicarla en Inspiración."
msgstr ""
"Füge deinem Stück Fotos hinzu, um es in Inspiration zu veröffentlichen."

msgid ""
"Guardar actualiza todas sus galerías y, si está publicada, Inspiración. Cada"
" galería mantiene su propia visibilidad."
msgstr ""
"Speichern aktualisiert alle Galerien und bei Veröffentlichung auch "
"Inspiration. Jede Galerie behält ihre Sichtbarkeit."

msgid "La ficha original sigue siendo privada."
msgstr "Der ursprüngliche Eintrag bleibt privat."

msgid "Puedes retirarla de Inspiración sin quitarla de sus galerías."
msgstr ""
"Du kannst es aus Inspiration entfernen und in seinen Galerien behalten."

msgid ""
"Las galerías muestran la presentación pública de esta pieza. Prepara sus "
"textos y selecciona sus fotos desde «Presentación pública»."
msgstr ""
"Galerien zeigen die öffentliche Präsentation dieses Stücks. Bereite Texte "
"und Fotos unter „Öffentliche Präsentation“ vor."

msgid ""
"Esta pieza tenía presentaciones diferentes en varias galerías. Hemos "
"conservado únicamente los textos y fotos comunes para no ampliar su "
"visibilidad. Aquí puedes consultar los originales antes de guardar la "
"presentación unificada."
msgstr ""
"Dieses Stück hatte unterschiedliche Präsentationen in mehreren Galerien. Nur"
" gemeinsame Texte und Fotos wurden übernommen, damit ihre Sichtbarkeit nicht"
" erweitert wird. Prüfe hier die Originale vor dem Speichern der gemeinsamen "
"Präsentation."

msgid "HECHO CON TIEMPO. COMPARTIDO PARA INSPIRAR."
msgstr "MIT ZEIT GESCHAFFEN. ZUR INSPIRATION GETEILT."

msgid ""
"Descubre las piezas de la comunidad, de la más reciente a la más antigua."
msgstr "Entdecke die Stücke der Community, von neu nach alt."

msgid "Publicar una de mis piezas"
msgstr "Eines meiner Stücke veröffentlichen"

msgid "Un espacio para lo que inspira"
msgstr "Ein Ort für Inspiration"

msgid "Las primeras piezas aparecerán aquí cuando sus autores las publiquen."
msgstr ""
"Die ersten Stücke erscheinen hier, sobald ihre Urheber sie veröffentlichen."

msgid "Ver pieza"
msgstr "Stück ansehen"

msgid "Ver más piezas"
msgstr "Weitere Stücke ansehen"

msgid "Ya has visto todas las piezas."
msgstr "Du hast alle Stücke gesehen."

msgid ""
"No se han podido cargar más piezas. Pulsa «Ver más piezas» para intentarlo "
"de nuevo."
msgstr ""
"Weitere Stücke konnten nicht geladen werden. Wähle „Weitere Stücke ansehen“,"
" um es erneut zu versuchen."

msgid "No se pudo cargar esta página. Vuelve a abrir Inspiración."
msgstr "Diese Seite konnte nicht geladen werden. Öffne Inspiration erneut."

msgid "Foto %(number)s"
msgstr "Foto %(number)s"

msgid ""
"Se eliminará esta foto de la ficha, de su presentación y de las galerías. Si"
" era la última foto publicada, la pieza se retirará de Inspiración. Esta "
"acción es definitiva."
msgstr ""
"Dieses Foto wird aus dem Eintrag, der Präsentation und den Galerien "
"gelöscht. War es das letzte veröffentlichte Foto, wird das Stück aus "
"Inspiration entfernt. Diese Aktion ist endgültig."

msgctxt "URL"
msgid "inspiracion/"
msgstr "inspiration/"

